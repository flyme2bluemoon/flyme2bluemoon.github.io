---
import GitHubIcon from "../assets/icons/github.svg";
import InstagramIcon from "../assets/icons/instagram.svg";
import MoonIcon from "../assets/icons/moon.svg";
import SunIcon from "../assets/icons/sun.svg";
import XIcon from "../assets/icons/x.svg";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = "Matthew Shen studied Computer Science and Biology at McGill University.",
} = Astro.props;

const pageTitle = title ? `${title} · Matthew Shen` : "Matthew Shen";
const path = Astro.url.pathname;
const isHome = path === "/";
// The same name sits in every page's header; on the home page it is also the page's h1.
const Name = isHome ? "h1" : "div";

const socials = [
  { label: "X", href: "https://x.com/flyme2bluemoon", Icon: XIcon },
  { label: "GitHub", href: "https://github.com/flyme2bluemoon", Icon: GitHubIcon },
  { label: "Instagram", href: "https://www.instagram.com/flyme2bluemoon", Icon: InstagramIcon },
];

const nav = [
  { href: "/#work", label: "Work" },
  { href: "/#projects", label: "Projects" },
  { href: "/writings/", label: "Writings" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <script is:inline>
      // Apply a saved theme before first paint so the page never flashes the other one.
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body class="min-h-dvh">
    <div class="mx-auto max-w-[680px] px-5 sm:px-6">
      <header class="flex flex-col gap-3 py-6 sm:flex-row sm:items-center sm:justify-between sm:py-8">
        <Name class="font-serif text-[36px] leading-none sm:text-[40px]">
          <a href="/">Matthew Shen</a>
        </Name>
        <div class="flex items-center gap-5 text-sm text-muted">
          <nav class="flex gap-5">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  class:list={["hover:text-ink", path.startsWith(item.href) && "text-ink"]}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          {/* Hidden until the script below runs, since it does nothing without JavaScript. */}
          <button
            type="button"
            id="theme-toggle"
            class="cursor-pointer transition-colors hover:text-ink"
            hidden
          >
            <MoonIcon class="size-[18px] dark:hidden" aria-hidden="true" />
            <SunIcon class="hidden size-[18px] dark:block" aria-hidden="true" />
          </button>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="mt-24 flex flex-col gap-6 border-t border-rule pt-12 pb-20 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
        <p>Toronto / Montréal / Singapore</p>
        <ul class="flex gap-5">
          {
            socials.map(({ label, href, Icon }) => (
              <li>
                <a href={href} class="block hover:text-ink" aria-label={label} title={label}>
                  <Icon class="size-[18px]" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </footer>
    </div>
  </body>
</html>

<script>
  // The toggle shows two states but stores three: no value (follow the OS), "light", or "dark".
  // Each click switches to the opposite of what's on screen. If that matches the OS, the saved
  // choice is cleared so the page follows the OS again; otherwise the choice is saved and kept
  // even if the OS changes later.
  const root = document.documentElement;
  const button = document.getElementById("theme-toggle")!;
  const prefersDark = matchMedia("(prefers-color-scheme: dark)");

  type Theme = "light" | "dark";

  const systemTheme = (): Theme => (prefersDark.matches ? "dark" : "light");
  const currentTheme = (): Theme => (root.dataset.theme as Theme | undefined) ?? systemTheme();
  const opposite = (theme: Theme): Theme => (theme === "dark" ? "light" : "dark");

  function updateLabel() {
    const label = `Switch to ${opposite(currentTheme())} theme`;
    button.setAttribute("aria-label", label);
    button.title = label;
  }

  function applyOverride(theme: string | null) {
    // Turn transitions off while the palette swaps, then back on once styles have recalculated.
    root.classList.add("switching-theme");
    if (theme === "light" || theme === "dark") root.dataset.theme = theme;
    else delete root.dataset.theme;
    document.body.offsetHeight;
    root.classList.remove("switching-theme");
    updateLabel();
  }

  button.addEventListener("click", () => {
    const next = opposite(currentTheme());
    const override = next === systemTheme() ? null : next;
    try {
      if (override) localStorage.setItem("theme", override);
      else localStorage.removeItem("theme");
    } catch {}
    applyOverride(override);
  });

  // Keep other open tabs in sync, and keep the label right when the OS theme changes.
  addEventListener("storage", (event) => {
    if (event.key === "theme") applyOverride(event.newValue);
  });
  prefersDark.addEventListener("change", updateLabel);

  updateLabel();
  button.hidden = false;
</script>
